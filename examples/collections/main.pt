fn main() int {
    // Maps: key-value pairs with type-safe access
    let mut scores = Map<string, int> { "alice": 95, "bob": 87, "charlie": 92 }
    print("Scores:")
    for name in scores.keys() {
        print(f"{name}: {scores[name]}")
    }
    print(f"Total students: {scores.len()}")

    // Index assignment
    scores["dave"] = 88
    print(f"After adding dave: {scores.len()}")

    // Update existing
    scores["bob"] = 90
    let bob_score = scores["bob"]
    print(f"Bob's new score: {bob_score}")

    // Contains + remove
    let has_alice = scores.contains("alice")
    print(f"Has alice? {has_alice}")
    scores.remove("alice")
    print(f"After removing alice: {scores.len()}")

    // Sets: unique collections
    let fruits = Set<string> { "apple", "banana", "cherry" }
    print(f"\nFruits: {fruits.len()} items")
    let has_apple = fruits.contains("apple")
    print(f"Has apple? {has_apple}")
    let has_grape = fruits.contains("grape")
    print(f"Has grape? {has_grape}")

    // Duplicates are ignored
    fruits.insert("apple")
    print(f"After re-inserting apple: {fruits.len()}")

    // Remove
    fruits.remove("banana")
    print(f"After removing banana: {fruits.len()}")

    // Iterate via to_array
    let mut total = 0
    let numbers = Set<int> { 10, 20, 30, 40 }
    for n in numbers.to_array() {
        total = total + n
    }
    print(f"\nSum of number set: {total}")

    return 0
}
