// Objects — entities, not data (docs/design/rfc-objects.md, phase 1).
//
// A class is bytes; an object is THE THING. Instances have reference
// identity (`==` compares identity, not fields), spawn SHARES them instead
// of deep-copying (an entity copied would be a second entity), and sharing
// is safe because an object's methods are serialized — it processes one
// message at a time. Objects never cross domain boundaries as values —
// they cross by reference, as identity handles (rfc-objects.md phase 2).

object Counter {
    value: int

    // A two-state invariant (rfc-properties.md atom 2): the counter is
    // MONOTONE. Proven at every mut-self method boundary against its entry
    // state and at every foreign write against the pre-write state — a
    // decrement anywhere would be a compile error, so "counts only go up"
    // is part of the entity's checked contract, not a comment.
    invariant self.value >= old(self.value)

    // The exact relation, proven at every normal exit and assumed by
    // callers (atom 1): one increment, exactly one more.
    fn increment(mut self) ensures self.value == old(self.value) + 1 {
        self.value = self.value + 1
    }

    fn work(mut self) ensures self.value >= old(self.value) {
        let mut i = 0
        while i < 1000 {
            self.value = self.value + 1
            i = i + 1
        }
    }

    fn get(self) int {
        return self.value
    }
}

fn main() {
    let mut c = Counter { value: 0 }
    let alias = c

    // Identity: two names, one entity
    print(c == alias)

    // Sharing: the spawned worker and main increment the SAME entity —
    // the class version of this program deep-copies and needs the
    // synchronized-singleton analysis; the object version shares by
    // construct and serializes by construct.
    let t = spawn c.work()
    let mut i = 0
    while i < 1000 {
        c.increment()
        i = i + 1
    }
    t.get()
    print(c.get())
    print(alias.get())
}
