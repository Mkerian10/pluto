// RPC server — the whole protocol server is generated by `serve`.
//
// `serve <service> on <port>` binds a TCP socket and loops: accept a
// connection, read a `<method>\n<args>` request, dispatch to the matching
// method, and write back the result. It prints the bound port on startup
// (use port 0 to let the OS choose one).
//
// Run it:
//   cargo run -- run examples/rpc/server.pt --stdlib stdlib
//
// Then point a client at the port it prints (see examples/rpc/client/).

import std.wire

class BillingService {
    rate: int

    fn charge(self, amount: int) int {
        return amount * self.rate
    }

    // Containers work as argument and return types too — arrays, maps, and
    // sets are marshaled through std.wire (hence the import above).
    fn charge_all(self, amounts: [int]) [int] {
        let mut out: [int] = []
        let mut i = 0
        while i < amounts.len() {
            out.push(amounts[i] * self.rate)
            i = i + 1
        }
        return out
    }
}

fn main() {
    let svc = BillingService { rate: 2 }
    serve svc on 9000
}
