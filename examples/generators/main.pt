fn range(start: int, end: int) stream int {
    let mut i = start
    while i < end {
        yield i
        i = i + 1
    }
}

fn fibonacci() stream int {
    let mut a = 0
    let mut b = 1
    while true {
        yield a
        let next = a + b
        a = b
        b = next
    }
}

// A generic generator that consumes another stream: stops after `count`
// values, so it can safely wrap an infinite one.
fn take<T>(s: stream T, count: int) stream T {
    let mut i = 0
    for x in s {
        if i >= count {
            return
        }
        yield x
        i = i + 1
    }
}

enum Token {
    Num { value: int }
    Plus
}

// `yield` works inside `for` loops and `match` arms, at any depth.
fn describe(tokens: [Token]) stream string {
    for t in tokens {
        match t {
            Token.Num { value } {
                yield f"number {value}"
            }
            Token.Plus {
                yield "plus"
            }
        }
    }
}

fn main() {
    print("Range 0..10:")
    for n in range(0, 10) {
        print(n)
    }

    print("Fibonacci up to 100:")
    for f in fibonacci() {
        if f > 100 {
            break
        }
        print(f)
    }

    print("First 5 Fibonacci numbers, via take:")
    for f in take(fibonacci(), 5) {
        print(f)
    }

    print("Tokens:")
    let tokens = [Token.Num { value: 1 }, Token.Plus, Token.Num { value: 2 }]
    for d in describe(tokens) {
        print(d)
    }
}
