// Bytes & byte type demo

fn main() int {
    // Hex literals
    let hex_val = 0xFF
    print(f"Hex 0xFF = {hex_val}")

    // Byte type — explicit conversion required. A literal proven in 0..255
    // narrows `byte?` to `byte`, so `.to_byte()` needs no fallback here.
    let b = (65).to_byte()
    print(f"Byte value: {b}")
    print(f"As int: {b.to_int()}")

    // Deliberate truncation: low_byte() keeps the low 8 bits (the checked
    // to_byte() would be none for these out-of-range values).
    let truncated = (256).low_byte()
    print(f"256.low_byte() = {truncated}")
    let neg = (-1).low_byte()
    print(f"-1.low_byte() = {neg}")

    // Bytes buffer
    let mut buf = bytes_new()
    buf.push((72).to_byte())
    buf.push((101).to_byte())
    buf.push((108).to_byte())
    buf.push((108).to_byte())
    buf.push((111).to_byte())
    print(f"Buffer length: {buf.len()}")

    // Convert to string
    let greeting = buf.to_string()
    print(greeting)

    // String to bytes and back
    let original = "Pluto"
    let mut raw = original.to_bytes()
    print(f"'{original}' is {raw.len()} bytes")
    print(f"First byte: {raw[0].to_int()}")

    // Iterate over bytes
    let mut sum = 0
    for byte_val in raw {
        sum = sum + (byte_val.to_int())
    }
    print(f"Sum of byte values: {sum}")

    // Index read and write
    raw[0] = (112).to_byte()
    let modified = raw.to_string()
    print(f"Modified: {modified}")

    // Byte ordering (unsigned)
    let high = (0xFF).to_byte()
    let low = (0x00).to_byte()
    if high > low {
        print("0xFF > 0x00: correct unsigned ordering")
    }

    // ── Bulk operations (no per-byte loops) ──────────────────────────────

    // slice: fresh copy of [start, end)
    let hello = "Hello, Pluto!".to_bytes()
    let word = hello.slice(7, 12)
    print(f"Slice [7, 12): {word.to_string()}")

    // extend: append a whole buffer at once
    let mut frame = "HEAD".to_bytes()
    frame.extend("BODY".to_bytes())
    print(f"Extended: {frame.to_string()}")

    // bytes_filled + fill
    let mut padding = bytes_filled(4, (0x2E).to_byte())
    print(f"Filled: {padding.to_string()}")
    padding.fill((0x2D).to_byte())
    print(f"Refilled: {padding.to_string()}")

    // copy_from: memmove semantics — overlap on the same buffer is fine
    let mut window = "abcdefgh".to_bytes()
    window.copy_from(window, 2, 0, 6)
    print(f"Shifted left by 2: {window.to_string()}")

    // find: first index of a byte at or after `from`, -1 when absent
    let csv = "a,b,c".to_bytes()
    print(f"First comma: {csv.find((0x2C).to_byte(), 0)}")
    print(f"Next comma: {csv.find((0x2C).to_byte(), 2)}")
    print(f"No 'z': {csv.find((0x7A).to_byte(), 0)}")

    // compare: lexicographic byte order (-1 / 0 / 1)
    print(f"abc vs abd: {"abc".to_bytes().compare("abd".to_bytes())}")
    print(f"abc vs abc: {"abc".to_bytes().compare("abc".to_bytes())}")

    // ── Fixed-width integer codecs ───────────────────────────────────────
    // read_*/write_* take and return plain int. There is no read_u64: a u64
    // with the top bit set cannot be represented in int (i64) — use
    // read_i64_le/read_i64_be. Out-of-range write values trap as defects.
    let mut packet = bytes_filled(15, (0).to_byte())
    packet.write_u8(0, 7)            // tag
    packet.write_u16_be(1, 513)      // length, network byte order
    packet.write_u32_be(3, 70000)    // id
    packet.write_i64_le(7, -5)       // payload
    print(f"tag: {packet.read_u8(0)}")
    print(f"length: {packet.read_u16_be(1)}")
    print(f"id: {packet.read_u32_be(3)}")
    print(f"payload: {packet.read_i64_le(7)}")

    return 0
}
