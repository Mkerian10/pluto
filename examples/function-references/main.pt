// Function references: named functions are first-class values.
// Bind them, pass them to higher-order functions, store them, return them.

fn double(x: int) int {
    return x * 2
}

fn triple(x: int) int {
    return x * 3
}

fn square(x: int) int {
    return x * x
}

fn apply(f: fn(int) int, x: int) int {
    return f(x)
}

// A fallible contract: `!` on the fn type accepts functions that may raise,
// and calls through the value must be handled.
error TooBig { value: int }

fn checked(x: int) int {
    if x > 100 {
        raise TooBig { value: x }
    }
    return x
}

fn apply_checked(f: fn(int) int!, x: int) int {
    return f(x)!
}

fn compose(f: fn(int) int, g: fn(int) int) fn(int) int {
    return (x: int) => g(f(x))
}

fn main() {
    // Bind a function to a variable and call it
    let f = double
    print(f(21))

    // Pass named functions to a higher-order function
    print(apply(triple, 5))

    // Store references in an array and iterate
    let ops = [double, triple, square]
    for op in ops {
        print(op(4))
    }

    // Compose two named functions into a new one
    let double_then_square = compose(double, square)
    print(double_then_square(3))

    // Fallible function values: the contract says failure is allowed,
    // so the caller handles it
    print(apply_checked(checked, 7) catch -1)
    print(apply_checked(checked, 700) catch -1)
}
