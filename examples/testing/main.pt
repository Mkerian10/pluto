fn add(a: int, b: int) int {
    return a + b
}

fn is_positive(n: int) bool {
    return n > 0
}

test "addition works" {
    expect(add(1, 2)).to_equal(3)
    expect(add(-1, 1)).to_equal(0)
    expect(add(0, 0)).to_equal(0)
}

test "negative addition" {
    expect(add(-5, -3)).to_equal(-8)
}

test "boolean logic" {
    expect(true).to_be_true()
    expect(false).to_be_false()
    expect(1 > 2).to_be_false()
    expect(is_positive(42)).to_be_true()
    expect(is_positive(-1)).to_be_false()
}

test "string equality" {
    expect("hello").to_equal("hello")
    expect("").to_equal("")
}

// ── Test-local DI containers ─────────────────────────────────────────────
// Inside a test body, scope() may seed singleton classes: the seed is the
// override (a fake), and unseeded dependencies are auto-created for the
// duration of the block. DI-wired code is testable without an app.

class PriceFeed {
    quote: int

    fn latest(self) int {
        return self.quote
    }
}

class Portfolio[feed: PriceFeed] {
    fn value(self, shares: int) int {
        return self.feed.latest() * shares
    }
}

test "portfolio uses injected feed" {
    scope(PriceFeed { quote: 50 }) |p: Portfolio| {
        expect(p.value(3)).to_equal(150)
    }
    scope(PriceFeed { quote: 100 }) |p: Portfolio| {
        expect(p.value(3)).to_equal(300)
    }
}

// ── Raises assertions ────────────────────────────────────────────────────
// expect_raises asserts that a block raises an error of a specific type.
// Inside the block, ! propagates to the construct itself — the test stays
// infallible, and the raise is consumed. The assertion is checked against
// the compiler's inferred error sets: a block that cannot raise, or an
// error type the block cannot produce, is a compile error.

error InvalidInput {
    reason: string
}

error OutOfRange {
    value: int
}

fn parse_percent(n: int) int {
    if n < 0 {
        raise InvalidInput { reason: "negative" }
    }
    if n > 100 {
        raise OutOfRange { value: n }
    }
    return n
}

test "negative input raises InvalidInput" {
    expect_raises(InvalidInput) {
        parse_percent(0 - 1)!
    }
}

test "oversized input raises OutOfRange" {
    expect_raises(OutOfRange) {
        let ok = parse_percent(100)!
        expect(ok).to_equal(100)
        parse_percent(101)!
    }
}

test "any raise satisfies the wildcard form" {
    expect_raises {
        parse_percent(999)!
    }
}
