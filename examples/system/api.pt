// A stateful service singleton is an entity: there is one order counter, and
// a copy of it would be a second, diverging counter — so it is an object.
object OrderService {
    count: int

    // Order numbers only move forward — a two-state invariant, proven at
    // every mut-self boundary. The exact `ensures count == old(count) + 1`
    // also proves: the trailing print() call provably cannot reach the
    // receiver, so it no longer severs exact two-state knowledge (the
    // purity-aware severing rule).
    invariant self.count >= old(self.count)

    fn process_order(mut self) ensures self.count == old(self.count) + 1 {
        self.count = self.count + 1
        print(f"processed order #{self.count}")
    }
}

app ApiApp[orders: OrderService] {
    fn main(self) {
        print("=== API Server ===")
        self.orders.process_order()
        self.orders.process_order()
        self.orders.process_order()
        print("api server done")
    }
}
