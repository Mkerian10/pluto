// The job runner is a stateful service — an entity, so declared as an object.
object JobRunner {
    jobs_done: int

    // The completed-jobs tally never goes down — proven at every mut-self
    // method boundary and foreign write site.
    invariant self.jobs_done >= old(self.jobs_done)

    fn run_job(mut self, name: string) ensures self.jobs_done == old(self.jobs_done) + 1 {
        self.jobs_done = self.jobs_done + 1
        print("completed job: " + name)
    }
}

app WorkerApp[runner: JobRunner] {
    fn main(self) {
        print("=== Background Worker ===")
        self.runner.run_job("send-emails")
        self.runner.run_job("generate-reports")
        print("worker done")
    }
}
