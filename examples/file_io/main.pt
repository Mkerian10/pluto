import std.fs

// Demonstrates file I/O: write, read, append, copy, directory ops.
//
// Run:
//   cargo run --release -- run --stdlib stdlib examples/file_io/main.pluto

fn main() {
    let tmp = fs.temp_dir()
    print(f"temp dir: {tmp}")

    // Write and read a file
    let path = tmp + "/greeting.txt"
    fs.write_all(path, "Hello, Pluto!")!
    let content = fs.read_all(path)!
    print(f"read: {content}")

    // File metadata
    print(f"exists: {fs.exists(path)}")
    print(f"is_file: {fs.is_file(path)}")
    print(f"size: {fs.file_size(path)!}")

    // Append to file
    fs.append_all(path, " Welcome.")!
    let updated = fs.read_all(path)!
    print(f"after append: {updated}")

    // Copy and rename
    let copy_path = tmp + "/copy.txt"
    fs.copy(path, copy_path)!
    print(f"copy exists: {fs.exists(copy_path)}")

    let renamed = tmp + "/renamed.txt"
    fs.rename(copy_path, renamed)!
    print(f"renamed exists: {fs.exists(renamed)}")
    print(f"copy gone: {fs.exists(copy_path)}")

    // Directory operations
    let sub = tmp + "/subdir"
    fs.mkdir(sub)!
    print(f"subdir is_dir: {fs.is_dir(sub)}")

    fs.write_all(sub + "/a.txt", "a")!
    fs.write_all(sub + "/b.txt", "b")!
    let entries = fs.list_dir(sub)!
    print(f"entries: {entries.len()}")

    // The typestated file handle: open_read mints a File<Read, Open> that
    // MUST be closed (forgetting f.close() is a compile error), reads exist
    // only in Read mode while Open, and seek takes a Seek target instead of
    // whence magic ints.
    let f = fs.open_read(path)!
    let first5 = f.read(5)!
    print(f"first 5: {first5}")
    f.seek(fs.Seek.Start { offset: 0 })!
    let all = f.read(1024)!
    print(f"seeked back: {all}")
    f.close()!

    // Error handling
    let missing = fs.read_all("/does_not_exist.txt") catch "file not found!"
    print(f"caught: {missing}")

    // Binary I/O (issue #368): bytes is the honest type for binary data.
    // A payload holding every byte value 0..256 round-trips exactly
    // through the one-shots, and read_at/write_at (pread/pwrite) address
    // the file positionally without touching the descriptor's cursor.
    let bin = tmp + "/payload.bin"
    let mut payload = bytes_new()
    let mut i = 0
    while i < 256 {
        payload.push(i.low_byte())
        i = i + 1
    }
    fs.write_all_bytes(bin, payload)!
    let back = fs.read_all_bytes(bin)!
    let mut intact = back.len() == 256
    let mut j = 0
    while j < back.len() {
        if (back[j].to_int()) != j {
            intact = false
        }
        j = j + 1
    }
    print(f"binary round-trip intact: {intact}")

    let b = fs.open_read(bin)!
    let head = b.read_bytes(2)!            // sequential: cursor now at 2
    let at16 = b.read_at(16, 2)!           // positional: cursor untouched
    let next = b.read_bytes(2)!            // continues from 2, proving it
    print(f"head {head[0].to_int()},{head[1].to_int()}  at16 {at16[0].to_int()},{at16[1].to_int()}  next {next[0].to_int()},{next[1].to_int()}")
    b.close()!
    fs.remove(bin)!

    // Truncation (issue #397): cut a file to an exact length in one
    // syscall — the WAL-recovery shape (drop a torn tail) without
    // read-all + rewrite + rename. Shrinking discards the tail,
    // extending zero-fills. The handle form composes with sync() when
    // the shrink must be durable; the path form is the one-shot.
    let wal = tmp + "/wal.log"
    fs.write_all(wal, "good entry|torn ent")!
    let w = fs.open_append(wal)!
    w.truncate(10)!                        // keep the valid prefix
    w.sync()!                              // the shrink is now warranted durable
    w.close()!
    print(f"after truncate: {fs.read_all(wal)!}")
    fs.truncate(wal, 4)!                   // path-level one-shot
    print(f"after path truncate: {fs.read_all(wal)!} (size {fs.file_size(wal)!})")
    fs.remove(wal)!

    // Cleanup
    fs.remove(sub + "/a.txt")!
    fs.remove(sub + "/b.txt")!
    fs.rmdir(sub)!
    fs.remove(path)!
    fs.remove(renamed)!
    fs.rmdir(tmp)!
    print("cleanup done")
}
