trait HasArea {
    fn area(self) int
}

trait Describable {
    fn label(self) string {
        return "shape"
    }
}

class Square impl HasArea, Describable {
    side: int

    fn area(self) int {
        return self.side * self.side
    }
}

class Rect impl HasArea, Describable {
    w: int
    h: int

    fn area(self) int {
        return self.w * self.h
    }

    fn label(self) string {
        return "rectangle"
    }
}

fn print_area(shape: HasArea) {
    print(shape.area())
}

// Generic traits: a trait template instantiated with concrete type arguments
trait Producer<U> {
    fn produce(self) U
}

class Doubler impl Producer<int> {
    n: int

    fn produce(self) int {
        return self.n * 2
    }
}

class Greeter impl Producer<string> {
    name: string

    fn produce(self) string {
        return f"hello {self.name}"
    }
}

// Generic trait objects dispatch dynamically like any trait
fn produce_int(p: Producer<int>) int {
    return p.produce()
}

fn main() {
    let s = Square { side: 5 }
    let r = Rect { w: 3, h: 4 }
    print_area(s)
    print_area(r)
    print(s.label())
    print(r.label())

    print(produce_int(Doubler { n: 21 }))
    print(Greeter { name: "pluto" }.produce())
}
