// Fresh containers filled with raw stores by the runtime (array slices)
// while their elements are young: a collection must never see such a
// container before the call that allocates it returns. The kept slices are
// the only path to their elements; churn forces collections throughout.
class Item {
    v: int
    w: int
}

fn main() {
    let mut keep: [[Item]] = []
    let mut i = 0
    let mut acc = 0
    while i < 60000 {
        let one = [Item { v: i, w: i * 3 }]
        let s = one.slice(0, 1)
        keep.push(s)
        let junk = Item { v: i, w: 0 }
        acc = acc + junk.v % 7
        if keep.len() > 2000 {
            let mut sum = 0
            for k in keep {
                sum = sum + k[0].w - k[0].v * 3
            }
            if sum != 0 {
                print(f"corrupt at {i}: {sum}")
            }
            keep = []
        }
        i = i + 1
    }
    let mut total = 0
    for k in keep {
        total = total + k[0].v
    }
    print(f"total={total} acc={acc}")
}
