// std.fs — the filesystem API as evidence (docs/design/rfc-fs-api.md).
//
// The OS is the authority: the filesystem owns the real state. A `File`
// value is a CAPABILITY the authority minted at open() — a linear,
// must-release piece of evidence ("I opened this and have not yet
// closed it"). Typestate makes the protocol compile-checked:
//
// - open_read/open_write/open_append mint a `File<_, Open>` in a
//   must-release state: dropping it, capturing it in a closure/spawn, or
//   storing it in a field is a compile error. fd leaks are inexpressible.
// - read/write/seek exist only `where S == Open` (and only in the right
//   mode): use-after-close, double-close, and write-on-a-read-handle are
//   not runtime errors; the methods do not exist on those types.
// - close() is a consuming transition to `Closed` (inert, droppable).
// - a failed write or sync DEGRADES the handle: the error carries the
//   file as `File<Write, Poisoned>`, and the only method on Poisoned is
//   discard(). The fsyncgate rule — never retry a failed sync, the
//   kernel cannot re-issue the durability warrant — is not
//   documentation; the method to retry does not exist on the type the
//   failure hands you. Recovery is reopen-and-rewrite from data the
//   program still owns, or crash and recover from a log.
//
// Durability (issue #367): sync() means FULL durability on every
// platform — fsync on Linux, fcntl(F_FULLFSYNC) on Darwin (Darwin's
// fsync does not flush the drive's volatile cache). ENOTSUP from
// F_FULLFSYNC (SMB/NFS mounts) raises; it never silently degrades.
// The implementation is syscall-faithful, not crash-tested: CI verifies
// the syscalls are issued and the error paths are honest; actual
// power-loss durability and drive-firmware honesty cannot be tested
// here.
//
// Every fs failure is DEFINITE (local syscalls — the request never
// leaves the process), so no failure here is ambiguous. The one
// epistemically special failure is sync: definite failure with
// retroactive scope — it destroys the warrant for previously-reported
// write successes. That is what Degraded-carrying-Poisoned encodes.

// ── Errors ───────────────────────────────────────────────────────────
//
// Split by what callers DO, not errno taxonomy: NotFound is the one
// branch-worthy case; FileError carries the path and the raw errno
// captured at the syscall site for everything else definite.

pub error FileError {
    path: string
    code: int
    message: string
}

// ENOENT — the branch-worthy case (404 shapes, config defaulting).
pub error NotFound {
    path: string
}

// close() failed. The fd is released regardless (POSIX deallocates the
// descriptor even when close fails) — this is a durability report, not
// a retry invitation.
pub error CloseError {
    code: int
    message: string
}

// One-shot durability failure (sync_dir, replace_all). For replace_all:
// SyncError means the rename LANDED but its durability is unwarranted
// (the directory fsync failed); FileError means the old file is intact.
pub error SyncError {
    path: string
    code: int
    message: string
}

// Degradation: a write or sync on an open handle failed, destroying the
// durability warrant for the fd. The payload is the file in its honest
// post-failure state — catching this consumes the Open binding (the
// value now lives in `.file`), and a wildcard catch cannot swallow it:
// the Poisoned payload is must-release, so only a typed handler that
// takes on the obligation is legal.
pub error Degraded {
    file: File<Write, Poisoned>
    code: int
    message: string
}

// ── Runtime externs ──────────────────────────────────────────────────
//
// Protocol: long-returning externs return >= 0 on success and -errno on
// failure; string/array-returning externs record errno in a
// thread-local read via __pluto_fs_last_errno() (0 = success), captured
// at the syscall site before control returns to Pluto code.

extern fn __pluto_fs_last_errno() int
extern fn __pluto_fs_errstr(code: int) string
extern fn __pluto_fs_err_noent() int
extern fn __pluto_fs_open_read(path: string) int
extern fn __pluto_fs_open_write(path: string) int
extern fn __pluto_fs_open_append(path: string) int
extern fn __pluto_fs_close(fd: int) int
extern fn __pluto_fs_read(fd: int, max_bytes: int) string
extern fn __pluto_fs_read_bytes(fd: int, max_bytes: int) bytes
extern fn __pluto_fs_read_at(fd: int, offset: int, max_bytes: int) bytes
extern fn __pluto_fs_write(fd: int, data: string) int
extern fn __pluto_fs_write_bytes(fd: int, data: bytes) int
extern fn __pluto_fs_write_at(fd: int, offset: int, data: bytes) int
extern fn __pluto_fs_send_to_socket(fd: int, sock_fd: int, offset: int, max_bytes: int) int
extern fn __pluto_fs_recv_from_socket(fd: int, sock_fd: int, max_bytes: int) int
extern fn __pluto_fs_relay_side() int
extern fn __pluto_fs_seek(fd: int, offset: int, whence_tag: int) int
extern fn __pluto_fs_truncate(fd: int, len: int) int
extern fn __pluto_fs_truncate_path(path: string, len: int) int
extern fn __pluto_fs_sync(fd: int) int
extern fn __pluto_fs_sync_data(fd: int) int
extern fn __pluto_fs_sync_dir(path: string) int
extern fn __pluto_fs_replace_all(path: string, data: string) int
extern fn __pluto_fs_replace_phase() int
extern fn __pluto_fs_read_all(path: string) string
extern fn __pluto_fs_write_all(path: string, data: string) int
extern fn __pluto_fs_append_all(path: string, data: string) int
extern fn __pluto_fs_read_all_bytes(path: string) bytes
extern fn __pluto_fs_write_all_bytes(path: string, data: bytes) int
extern fn __pluto_fs_append_all_bytes(path: string, data: bytes) int
extern fn __pluto_fs_exists(path: string) int
extern fn __pluto_fs_file_size(path: string) int
extern fn __pluto_fs_stat(path: string) [int]
extern fn __pluto_fs_is_dir(path: string) int
extern fn __pluto_fs_is_file(path: string) int
extern fn __pluto_fs_remove(path: string) int
extern fn __pluto_fs_mkdir(path: string) int
extern fn __pluto_fs_create_dir_all(path: string) int
extern fn __pluto_fs_rmdir(path: string) int
extern fn __pluto_fs_remove_dir_all(path: string) int
extern fn __pluto_fs_rename(from: string, to: string) int
extern fn __pluto_fs_copy(from: string, to: string) int
extern fn __pluto_fs_list_dir(path: string) [string]
extern fn __pluto_fs_temp_dir() string

// ── Typestate markers ────────────────────────────────────────────────
// Plain classes used as phantom type arguments; never constructed.

// Modes — fixed at open, never transition.
pub class Read { tag: int }
pub class Write { tag: int }

// States.
pub class Open { tag: int }
pub class Poisoned { tag: int }
pub class Closed { tag: int }

// Seek target (replaces the old whence-int constants).
pub enum Seek {
    Start { offset: int }
    Current { delta: int }
    End { delta: int }
}

// ── The handle ───────────────────────────────────────────────────────

pub class File<M, S> {
    priv fd: int

    // The descriptor is fixed for the value's whole life within a state
    // (two-state frame invariant, proven once on the template — the
    // vocabulary is param-independent). Transitions construct fresh
    // values carrying the same fd; no "-1 after close" sentinel exists
    // anywhere.
    invariant self.fd == old(self.fd)

    // Evidence is not duplicable and may not be abandoned: an Open or
    // Poisoned handle must be transitioned out (close/discard), moved
    // onward, or returned. Closed is inert and droppable.
    must_release S == Open
    must_release S == Poisoned

    // Read up to max_bytes. "" means EOF; failures raise FileError (the
    // runtime disambiguates EOF from error, so "" is never a disguised
    // failure). `requires max_bytes > 0` feeds the prover; call sites
    // that guard (or pass literals) are provable, and the entry check
    // elides via the $nochk twin once per-instantiation twins land for
    // generic-class methods (contracts.md phase 6).
    fn read(self, max_bytes: int) string
        where M == Read, S == Open
        requires max_bytes > 0
    {
        let s = __pluto_fs_read(self.fd, max_bytes)
        let e = __pluto_fs_last_errno()
        if e != 0 {
            raise FileError { path: "", code: e, message: __pluto_fs_errstr(e) }
        }
        return s
    }

    // Binary read (issue #368): same contract as read, with bytes as the
    // honest type for binary data — no encoding, no interpolation, just
    // octets. Empty bytes means EOF; failures raise FileError.
    fn read_bytes(self, max_bytes: int) bytes
        where M == Read, S == Open
        requires max_bytes > 0
    {
        let b = __pluto_fs_read_bytes(self.fd, max_bytes)
        let e = __pluto_fs_last_errno()
        if e != 0 {
            raise FileError { path: "", code: e, message: __pluto_fs_errstr(e) }
        }
        return b
    }

    // Positioned read (pread): reads at an absolute offset WITHOUT touching
    // the descriptor's seek cursor — correct under any sharing with no
    // locks, and the honest answer to the seek+read two-call race (the
    // #368 investigation: entity serialization never made that pair
    // atomic). Empty bytes means EOF at that offset.
    fn read_at(self, offset: int, max_bytes: int) bytes
        where M == Read, S == Open
        requires offset >= 0
        requires max_bytes > 0
    {
        let b = __pluto_fs_read_at(self.fd, offset, max_bytes)
        let e = __pluto_fs_last_errno()
        if e != 0 {
            raise FileError { path: "", code: e, message: __pluto_fs_errstr(e) }
        }
        return b
    }

    // Kernel-assisted relay (issue #373): transfer up to max_bytes from
    // this file, starting at offset, into a connected stream socket —
    // sendfile(2) where the kernel offers it, a runtime-C pread→write
    // loop otherwise. The bytes never touch the GC heap, and the
    // descriptor's seek cursor is neither read nor moved (offset-explicit,
    // like read_at). Returns the count sent: less than max_bytes means
    // EOF arrived first or the transfer was partial (e.g. EAGAIN after
    // progress) — callers loop, advancing offset by the return value.
    // Takes the socket as a raw fd (net.TcpConnection.fd(), or std.socket
    // directly): fs stays dependency-free and the handle obligation never
    // moves. Does NOT consume the handle — relay failure raises FileError
    // with the file still sound (the failing party is the socket; the
    // read capability is untouched), so retry from a new offset is
    // well-defined.
    fn send_to(self, socket_fd: int, offset: int, max_bytes: int) int
        where M == Read, S == Open
        requires offset >= 0
        requires max_bytes > 0
    {
        let n = __pluto_fs_send_to_socket(self.fd, socket_fd, offset, max_bytes)
        if n < 0 {
            let code = 0 - n
            raise FileError { path: "", code: code, message: __pluto_fs_errstr(code) }
        }
        return n
    }

    // The socket→file direction (issue #373): read from the socket, write
    // at this file's current cursor, up to max_bytes, through a runtime-C
    // scratch buffer (no kernel primitive exists on Darwin; the point is
    // that the bytes never round-trip the GC heap). Returns bytes written;
    // 0 means the socket was at EOF before any data — the loop terminator.
    // The failure asymmetry is the typestate's point: a FILE-side write
    // failure destroys the durability warrant exactly like write(), so it
    // raises Degraded carrying this file as File<Write, Poisoned>; a
    // SOCKET-side read failure leaves the file sound and raises FileError.
    fn receive_from(self, socket_fd: int, max_bytes: int) int
        where M == Write, S == Open
        requires max_bytes > 0
    {
        let n = __pluto_fs_recv_from_socket(self.fd, socket_fd, max_bytes)
        if n < 0 {
            let code = 0 - n
            if __pluto_fs_relay_side() == 1 {
                raise Degraded {
                    file: File<Write, Poisoned> { fd: self.fd },
                    code: code,
                    message: __pluto_fs_errstr(code)
                }
            }
            raise FileError { path: "", code: code, message: __pluto_fs_errstr(code) }
        }
        return n
    }

    // Write all of data: loops to completion, so success means every
    // byte reached the OS (short writes are never silently dropped). A
    // failed write leaves the prefix state unknown — the same destroyed
    // warrant as a failed sync — so the handle degrades (owner decision
    // D3): the error carries this file as File<Write, Poisoned>.
    fn write(self, data: string)
        where M == Write, S == Open
    {
        let n = __pluto_fs_write(self.fd, data)
        if n < 0 {
            let code = 0 - n
            raise Degraded {
                file: File<Write, Poisoned> { fd: self.fd },
                code: code,
                message: __pluto_fs_errstr(code)
            }
        }
    }

    // Binary write (issue #368): write-all loop and degradation contract
    // identical to write — a failed write leaves the prefix state unknown,
    // so the handle poisons (owner decision D3).
    fn write_bytes(self, data: bytes)
        where M == Write, S == Open
    {
        let n = __pluto_fs_write_bytes(self.fd, data)
        if n < 0 {
            let code = 0 - n
            raise Degraded {
                file: File<Write, Poisoned> { fd: self.fd },
                code: code,
                message: __pluto_fs_errstr(code)
            }
        }
    }

    // Positioned write (pwrite): writes all of data at an absolute offset
    // WITHOUT touching the descriptor's seek cursor. Loops on short
    // writes; a failure degrades the handle like write. Note: on an
    // O_APPEND fd (open_append) Linux appends regardless of the offset —
    // documented, as everywhere else.
    fn write_at(self, offset: int, data: bytes)
        where M == Write, S == Open
        requires offset >= 0
    {
        let n = __pluto_fs_write_at(self.fd, offset, data)
        if n < 0 {
            let code = 0 - n
            raise Degraded {
                file: File<Write, Poisoned> { fd: self.fd },
                code: code,
                message: __pluto_fs_errstr(code)
            }
        }
    }

    // Set the file's length to exactly len bytes (ftruncate, issue
    // #397): shrinking discards the tail, extending zero-fills —
    // syscall-faithful POSIX semantics, documented rather than
    // restricted (the WAL recovery that cuts a torn tail and the
    // preallocator that grows a segment are the same operation to the
    // kernel). The seek cursor does NOT move: a cursor past the new end
    // is legal, and the next sequential write zero-fills the gap.
    //
    // Negative len raises FileError (code 0), checked before any
    // syscall touches the fd: it is a condition on caller input, and
    // the file's warrant is intact — the same sound-file/destroyed-
    // warrant split receive_from draws between its socket-side and
    // file-side failures. A FAILED ftruncate, by contrast, leaves the
    // resulting length/data state unwarranted exactly like a failed
    // write, so the handle degrades (owner decision D3 applies).
    //
    // Durability: truncate dirties the inode (the size) and, when
    // shrinking, data pages — the change is warranted durable only
    // after sync()/sync_data(), like any write. No directory sync is
    // needed (the name→inode mapping is untouched).
    fn truncate(self, len: int)
        where M == Write, S == Open
    {
        if len < 0 {
            raise FileError { path: "", code: 0, message: "truncate: negative length" }
        }
        let r = __pluto_fs_truncate(self.fd, len)
        if r < 0 {
            let code = 0 - r
            raise Degraded {
                file: File<Write, Poisoned> { fd: self.fd },
                code: code,
                message: __pluto_fs_errstr(code)
            }
        }
    }

    // Full durability: after this returns, everything previously
    // written through this fd is durable — fsync on Linux, F_FULLFSYNC
    // on Darwin. On failure the durability warrant for this fd is
    // destroyed and the kernel cannot re-issue it (errseq_t reports
    // once and marks pages clean — fsyncgate): the handle degrades.
    fn sync(self)
        where M == Write, S == Open
    {
        let r = __pluto_fs_sync(self.fd)
        if r < 0 {
            let code = 0 - r
            raise Degraded {
                file: File<Write, Poisoned> { fd: self.fd },
                code: code,
                message: __pluto_fs_errstr(code)
            }
        }
    }

    // Data + size metadata only (skips mtime-only flushes): fdatasync
    // on Linux; on Darwin there is no honest cheaper form, so this is
    // F_FULLFSYNC too. Same degradation contract as sync().
    fn sync_data(self)
        where M == Write, S == Open
    {
        let r = __pluto_fs_sync_data(self.fd)
        if r < 0 {
            let code = 0 - r
            raise Degraded {
                file: File<Write, Poisoned> { fd: self.fd },
                code: code,
                message: __pluto_fs_errstr(code)
            }
        }
    }

    // Reposition the OS cursor; returns the new offset. Both modes:
    // seek is how a reader skips and how a writer (non-append)
    // repositions. Note: there is no `pos` field mirroring the cursor —
    // that would be a belief about the authority's state presented as
    // knowledge (O_APPEND writes and short reads would falsify it).
    fn seek(self, to: Seek) int
        where S == Open
    {
        let mut off = 0
        let mut tag = 0
        match to {
            Seek.Start { offset: o } {
                off = o
                tag = 0
            }
            Seek.Current { delta: d } {
                off = d
                tag = 1
            }
            Seek.End { delta: d } {
                off = d
                tag = 2
            }
        }
        let r = __pluto_fs_seek(self.fd, off, tag)
        if r < 0 {
            let code = 0 - r
            raise FileError { path: "", code: code, message: __pluto_fs_errstr(code) }
        }
        return r
    }

    // Consuming transition out: releases the fd and discharges the
    // obligation. Surfaces the close() result — on NFS-class
    // filesystems close is where deferred write errors appear — but
    // either way the fd is gone (POSIX deallocates the descriptor even
    // when close fails): CloseError is a durability report, not a retry
    // invitation. The returned Closed value is inert and droppable, so
    // `f.close()!` in statement position fully discharges.
    fn close(self) File<M, Closed>
        where S == Open
    {
        let r = __pluto_fs_close(self.fd)
        if r < 0 {
            let code = 0 - r
            raise CloseError { code: code, message: __pluto_fs_errstr(code) }
        }
        return File<M, Closed> { fd: self.fd }
    }

    // The only exit from Poisoned. Closes the fd and NEVER raises: the
    // durability warrant for this fd is already destroyed, so a close
    // report would be testimony about nothing. Recovery is
    // reopen-and-rewrite from data the program still owns.
    fn discard(self) File<M, Closed>
        where S == Poisoned
    {
        __pluto_fs_close(self.fd)
        return File<M, Closed> { fd: self.fd }
    }
}

// ── Constructors: the authority mints evidence ───────────────────────

// Raises NotFound | FileError.
pub fn open_read(path: string) File<Read, Open> {
    let fd = __pluto_fs_open_read(path)
    if fd < 0 {
        raise_path_error(path, 0 - fd)!
    }
    return File<Read, Open> { fd: fd }
}

// O_WRONLY|O_CREAT|O_TRUNC.
pub fn open_write(path: string) File<Write, Open> {
    let fd = __pluto_fs_open_write(path)
    if fd < 0 {
        raise_path_error(path, 0 - fd)!
    }
    return File<Write, Open> { fd: fd }
}

// O_WRONLY|O_CREAT|O_APPEND. Append-ness lives in the fd (O_APPEND),
// not the type: a third mode marker would force method duplication for
// no checked gain.
pub fn open_append(path: string) File<Write, Open> {
    let fd = __pluto_fs_open_append(path)
    if fd < 0 {
        raise_path_error(path, 0 - fd)!
    }
    return File<Write, Open> { fd: fd }
}

// ── Metadata ─────────────────────────────────────────────────────────

pub class Metadata {
    size: int
    modified: int        // unix seconds
    is_dir: bool
    is_file: bool
    mode: int            // permission bits

    invariant self.size >= 0
    // Constructed by stat() behind an `if size < 0 { raise }` guard —
    // the construction proof discharges from the flow fact. std.fs
    // proves its own invariant; callers assume size >= 0 for free.
}

// Raises NotFound | FileError.
pub fn stat(path: string) Metadata {
    let a = __pluto_fs_stat(path)
    if a.len() == 0 {
        raise_path_error(path, __pluto_fs_last_errno())!
    }
    let size = a[0]
    if size < 0 {
        raise FileError { path: path, code: 0, message: "stat reported a negative size" }
    }
    return Metadata {
        size: size,
        modified: a[1],
        is_dir: a[2] == 1,
        is_file: a[3] == 1,
        mode: a[4]
    }
}

// ── One-shot helpers ─────────────────────────────────────────────────
// The fd lives and dies inside the call, so no evidence value appears;
// close() errors are folded into the result (issue #367 fix) — success
// means the bytes were written AND the descriptor closed cleanly.

// Raises NotFound | FileError.
pub fn read_all(path: string) string {
    let s = __pluto_fs_read_all(path)
    let e = __pluto_fs_last_errno()
    if e != 0 {
        raise_path_error(path, e)!
    }
    return s
}

pub fn write_all(path: string, data: string) {
    let r = __pluto_fs_write_all(path, data)
    if r < 0 {
        raise_path_error(path, 0 - r)!
    }
}

pub fn append_all(path: string, data: string) {
    let r = __pluto_fs_append_all(path, data)
    if r < 0 {
        raise_path_error(path, 0 - r)!
    }
}

// ── Binary one-shots (issue #368) ────────────────────────────────────
// Same close-error-surfacing and short-write-loop discipline as the
// string forms; bytes is the honest type for binary data.

// Raises NotFound | FileError.
pub fn read_all_bytes(path: string) bytes {
    let b = __pluto_fs_read_all_bytes(path)
    let e = __pluto_fs_last_errno()
    if e != 0 {
        raise_path_error(path, e)!
    }
    return b
}

pub fn write_all_bytes(path: string, data: bytes) {
    let r = __pluto_fs_write_all_bytes(path, data)
    if r < 0 {
        raise_path_error(path, 0 - r)!
    }
}

pub fn append_all_bytes(path: string, data: bytes) {
    let r = __pluto_fs_append_all_bytes(path, data)
    if r < 0 {
        raise_path_error(path, 0 - r)!
    }
}

// Atomic durable replace (issue #367): write a temp file in the same
// directory, sync it to full durability, rename it over `path`, then
// fsync the parent directory (the name→inode mapping is the DIRECTORY's
// dirty page, not the file's). The four steps are packaged because the
// only safe traversal is this one, and intermediate failures must clean
// up the temp file.
//
// Error contract: FileError ⇒ the old file is intact (failure before
// the rename; the temp was cleaned up). SyncError ⇒ the rename landed
// but its durability is unwarranted (the directory fsync failed).
pub fn replace_all(path: string, data: string) {
    let r = __pluto_fs_replace_all(path, data)
    if r < 0 {
        let code = 0 - r
        if __pluto_fs_replace_phase() == 1 {
            raise SyncError { path: path, code: code, message: __pluto_fs_errstr(code) }
        }
        raise_path_error(path, code)!
    }
}

// fsync a directory: required for crash-safe rename/create/remove
// compositions. One-shot by nature (there is no directory handle).
pub fn sync_dir(path: string) {
    let r = __pluto_fs_sync_dir(path)
    if r < 0 {
        let code = 0 - r
        raise SyncError { path: path, code: code, message: __pluto_fs_errstr(code) }
    }
}

pub fn exists(path: string) bool {
    return __pluto_fs_exists(path) == 1
}

// Raises NotFound | FileError. Equivalent to stat(path).size.
pub fn file_size(path: string) int {
    return stat(path)!.size
}

pub fn is_dir(path: string) bool {
    return __pluto_fs_is_dir(path) == 1
}

pub fn is_file(path: string) bool {
    return __pluto_fs_is_file(path) == 1
}

pub fn remove(path: string) {
    let r = __pluto_fs_remove(path)
    if r < 0 {
        raise_path_error(path, 0 - r)!
    }
}

pub fn mkdir(path: string) {
    let r = __pluto_fs_mkdir(path)
    if r < 0 {
        raise_path_error(path, 0 - r)!
    }
}

// mkdir -p: creates every missing component; an existing directory is
// success.
pub fn create_dir_all(path: string) {
    let r = __pluto_fs_create_dir_all(path)
    if r < 0 {
        raise_path_error(path, 0 - r)!
    }
}

pub fn rmdir(path: string) {
    let r = __pluto_fs_rmdir(path)
    if r < 0 {
        raise_path_error(path, 0 - r)!
    }
}

// Recursive delete (rm -rf). Refuses "/" and "" outright. Symlinks are
// unlinked, never followed.
pub fn remove_dir_all(path: string) {
    if path == "" {
        raise FileError { path: path, code: 0, message: "remove_dir_all: refusing to remove empty path" }
    }
    if path == "/" {
        raise FileError { path: path, code: 0, message: "remove_dir_all: refusing to remove /" }
    }
    let r = __pluto_fs_remove_dir_all(path)
    if r < 0 {
        raise_path_error(path, 0 - r)!
    }
}

pub fn rename(from: string, to: string) {
    let r = __pluto_fs_rename(from, to)
    if r < 0 {
        raise_path_error(from, 0 - r)!
    }
}

// Close errors on either descriptor are surfaced (issue #367 fix);
// both descriptors are always released.
pub fn copy(from: string, to: string) {
    let r = __pluto_fs_copy(from, to)
    if r < 0 {
        raise_path_error(from, 0 - r)!
    }
}

// Path-level truncate (truncate(2), issue #397): set the file at
// `path` to exactly len bytes without minting a handle — shrinking
// discards the tail, extending zero-fills. Negative len raises
// FileError before any syscall (a condition on caller input).
// Raises NotFound | FileError.
//
// Durability stance matches write_all: success means the kernel
// accepted the new length, not that it is durable. A recovery path
// that must make the shrink durable uses the handle form —
// open_append → truncate → sync → close — so the fd exists to sync.
pub fn truncate(path: string, len: int) {
    if len < 0 {
        raise FileError { path: path, code: 0, message: "truncate: negative length" }
    }
    let r = __pluto_fs_truncate_path(path, len)
    if r < 0 {
        raise_path_error(path, 0 - r)!
    }
}

// Raises NotFound | FileError (e.g. ENOTDIR).
pub fn list_dir(path: string) [string] {
    let entries = __pluto_fs_list_dir(path)
    let e = __pluto_fs_last_errno()
    if e != 0 {
        raise_path_error(path, e)!
    }
    return entries
}

pub fn temp_dir() string {
    return __pluto_fs_temp_dir()
}

// ── Internal ─────────────────────────────────────────────────────────

// The uniform path-failure raise: ENOENT is the branch-worthy case and
// becomes NotFound; every other errno is a general FileError carrying
// the raw code captured at the syscall site.
fn raise_path_error(path: string, code: int) {
    if code == __pluto_fs_err_noent() {
        raise NotFound { path: path }
    }
    raise FileError { path: path, code: code, message: __pluto_fs_errstr(code) }
}
