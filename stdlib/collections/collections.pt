import std.strings

pub class Pair<A, B> {
    first: A
    second: B
}

pub fn map<T, U>(arr: [T], f: fn(T) U) [U] {
    let result: [U] = []
    for item in arr {
        result.push(f(item))
    }
    return result
}

pub fn filter<T>(arr: [T], f: fn(T) bool) [T] {
    let result: [T] = []
    for item in arr {
        if f(item) {
            result.push(item)
        }
    }
    return result
}

pub fn fold<T, U>(arr: [T], initial: U, f: fn(U, T) U) U {
    let mut acc = initial
    for item in arr {
        acc = f(acc, item)
    }
    return acc
}

pub fn reduce<T>(arr: [T], f: fn(T, T) T) T {
    let mut acc = arr[0]
    let mut i = 1
    while i < arr.len() {
        acc = f(acc, arr[i])
        i = i + 1
    }
    return acc
}

pub fn any<T>(arr: [T], f: fn(T) bool) bool {
    for item in arr {
        if f(item) {
            return true
        }
    }
    return false
}

pub fn all<T>(arr: [T], f: fn(T) bool) bool {
    for item in arr {
        if !f(item) {
            return false
        }
    }
    return true
}

pub fn for_each<T>(arr: [T], f: fn(T)) {
    for item in arr {
        f(item)
    }
}

pub fn flat_map<T, U>(arr: [T], f: fn(T) [U]) [U] {
    let result: [U] = []
    for item in arr {
        let sub = f(item)
        for x in sub {
            result.push(x)
        }
    }
    return result
}

pub fn count<T>(arr: [T], f: fn(T) bool) int {
    let mut n = 0
    for item in arr {
        if f(item) {
            n = n + 1
        }
    }
    return n
}

pub fn reverse<T>(arr: [T]) [T] {
    let result: [T] = []
    let mut i = arr.len() - 1
    while i >= 0 {
        result.push(arr[i])
        i = i - 1
    }
    return result
}

pub fn take<T>(arr: [T], n: int) [T] {
    let result: [T] = []
    let mut limit = n
    if limit > arr.len() {
        limit = arr.len()
    }
    let mut i = 0
    while i < limit {
        result.push(arr[i])
        i = i + 1
    }
    return result
}

pub fn drop<T>(arr: [T], n: int) [T] {
    let result: [T] = []
    let mut start = n
    if start > arr.len() {
        start = arr.len()
    }
    let mut i = start
    while i < arr.len() {
        result.push(arr[i])
        i = i + 1
    }
    return result
}

pub fn zip<A, B>(a: [A], b: [B]) [Pair<A, B>] {
    let result: [Pair<A, B>] = []
    let mut limit = a.len()
    if b.len() < limit {
        limit = b.len()
    }
    let mut i = 0
    while i < limit {
        result.push(Pair<A, B> { first: a[i], second: b[i] })
        i = i + 1
    }
    return result
}

pub fn enumerate<T>(arr: [T]) [Pair<int, T>] {
    let result: [Pair<int, T>] = []
    let mut i = 0
    while i < arr.len() {
        result.push(Pair<int, T> { first: i, second: arr[i] })
        i = i + 1
    }
    return result
}

pub fn flatten<T>(arr: [[T]]) [T] {
    let result: [T] = []
    for sub in arr {
        for item in sub {
            result.push(item)
        }
    }
    return result
}

pub fn sum(arr: [int]) int {
    let mut total = 0
    for x in arr {
        total = total + x
    }
    return total
}

pub fn sum_float(arr: [float]) float {
    let mut total = 0.0
    for x in arr {
        total = total + x
    }
    return total
}

// ── Sorting ──────────────────────────────────────────────────────────────────
// All sorts return a NEW sorted array and leave the input untouched.
//
// Stability guarantee: every sort here is STABLE. Elements that compare
// equal (neither less(a, b) nor less(b, a)) keep their original relative
// order. Sorting by a secondary key and then by a primary key therefore
// yields records ordered by primary key, ties broken by the secondary key.
//
// Implementation: bottom-up merge sort, O(n log n) comparisons in the worst
// case, O(n) extra space.

// Sort `arr` using `less(a, b)`, which must return true when a should come
// strictly before b. `less` must be a strict weak ordering (returning true
// for equal elements breaks the stability guarantee). Use `(a, b) => a < b`
// for ascending order, `(a, b) => a > b` for descending.
pub fn sort_by<T>(arr: [T], less: fn(T, T) bool) [T] {
    let n = arr.len()
    let mut src: [T] = []
    let mut dst: [T] = []
    for item in arr {
        src.push(item)
        dst.push(item)
    }
    let mut width = 1
    while width < n {
        let mut lo = 0
        while lo < n {
            let mut mid = n
            if width < n - lo {
                mid = lo + width
            }
            let mut hi = n
            if width < n - mid {
                hi = mid + width
            }
            let mut i = lo
            let mut j = mid
            let mut k = lo
            while k < hi {
                // Take from the right run only when its head is strictly
                // less than the left head; ties go left, which is what
                // keeps the sort stable.
                let mut take_left = true
                if i >= mid {
                    take_left = false
                } else if j < hi {
                    if less(src[j], src[i]) {
                        take_left = false
                    }
                }
                if take_left {
                    dst[k] = src[i]
                    i = i + 1
                } else {
                    dst[k] = src[j]
                    j = j + 1
                }
                k = k + 1
            }
            lo = hi
        }
        let tmp = src
        src = dst
        dst = tmp
        if width > n - width {
            width = n
        } else {
            width = width * 2
        }
    }
    return src
}

// Sort ints in ascending order (stable).
pub fn sort(arr: [int]) [int] {
    return sort_by(arr, (a: int, b: int) => a < b)
}

// Sort floats in ascending order (stable). NaN is never less than anything,
// so NaNs keep their relative position among the elements they tie with.
pub fn sort_floats(arr: [float]) [float] {
    return sort_by(arr, (a: float, b: float) => a < b)
}

// Sort strings in ascending lexicographic byte order (stable); see
// strings.compare for the ordering.
pub fn sort_strings(arr: [string]) [string] {
    return sort_by(arr, (a: string, b: string) => strings.compare(a, b) < 0)
}

// ── Fallible-callback variants ───────────────────────────────────────────────
// These accept callbacks that may raise (`fn(T) U!`) and propagate the first
// error to the caller. Infallible callbacks are accepted too (subsumption),
// but calls to try_* must always be handled with `!` or `catch`.

pub fn try_map<T, U>(arr: [T], f: fn(T) U!) [U] {
    let result: [U] = []
    for item in arr {
        result.push(f(item)!)
    }
    return result
}

pub fn try_filter<T>(arr: [T], f: fn(T) bool!) [T] {
    let result: [T] = []
    for item in arr {
        if f(item)! {
            result.push(item)
        }
    }
    return result
}

pub fn try_fold<T, U>(arr: [T], initial: U, f: fn(U, T) U!) U {
    let mut acc = initial
    for item in arr {
        acc = f(acc, item)!
    }
    return acc
}

pub fn try_for_each<T>(arr: [T], f: fn(T)!) {
    for item in arr {
        f(item)!
    }
}
