extern fn __pluto_string_substring(s: string, start: int, length: int) string
extern fn __pluto_string_contains(haystack: string, needle: string) int
extern fn __pluto_string_starts_with(s: string, prefix: string) int
extern fn __pluto_string_ends_with(s: string, suffix: string) int
extern fn __pluto_string_index_of(haystack: string, needle: string) int
extern fn __pluto_string_trim(s: string) string
extern fn __pluto_string_to_upper(s: string) string
extern fn __pluto_string_to_lower(s: string) string
extern fn __pluto_string_replace(s: string, old: string, new_str: string) string
extern fn __pluto_string_split(s: string, delim: string) [string]
extern fn __pluto_string_char_at(s: string, index: int) string
extern fn __pluto_string_len(s: string) int
extern fn __pluto_string_byte_at(s: string, index: int) int
extern fn __pluto_string_format_float(v: float) string
extern fn __pluto_string_trim_start(s: string) string
extern fn __pluto_string_trim_end(s: string) string
extern fn __pluto_string_last_index_of(haystack: string, needle: string) int
extern fn __pluto_string_count(haystack: string, needle: string) int
extern fn __pluto_string_is_empty(s: string) int
extern fn __pluto_string_is_whitespace(s: string) int
extern fn __pluto_string_repeat(s: string, count: int) string

pub fn substring(s: string, start: int, length: int) string {
    return __pluto_string_substring(s, start, length)
}

pub fn contains(s: string, needle: string) bool {
    return __pluto_string_contains(s, needle) != 0
}

pub fn starts_with(s: string, prefix: string) bool {
    return __pluto_string_starts_with(s, prefix) != 0
}

pub fn ends_with(s: string, suffix: string) bool {
    return __pluto_string_ends_with(s, suffix) != 0
}

pub fn index_of(s: string, needle: string) int {
    return __pluto_string_index_of(s, needle)
}

pub fn trim(s: string) string {
    return __pluto_string_trim(s)
}

pub fn to_upper(s: string) string {
    return __pluto_string_to_upper(s)
}

pub fn to_lower(s: string) string {
    return __pluto_string_to_lower(s)
}

pub fn replace(s: string, old: string, new_str: string) string {
    return __pluto_string_replace(s, old, new_str)
}

pub fn split(s: string, delim: string) [string] {
    return __pluto_string_split(s, delim)
}

pub fn char_at(s: string, index: int) string {
    return __pluto_string_char_at(s, index)
}

pub fn len(s: string) int {
    return __pluto_string_len(s)
}

pub fn byte_at(s: string, index: int) int {
    return __pluto_string_byte_at(s, index)
}

pub fn format_float(v: float) string {
    return __pluto_string_format_float(v)
}

pub fn join(arr: [string], sep: string) string {
    if arr.len() == 0 {
        return ""
    }
    let mut result = arr[0]
    for i in 1..arr.len() {
        result = result + sep + arr[i]
    }
    return result
}

pub fn trim_start(s: string) string {
    return __pluto_string_trim_start(s)
}

pub fn trim_end(s: string) string {
    return __pluto_string_trim_end(s)
}

pub fn last_index_of(s: string, needle: string) int {
    return __pluto_string_last_index_of(s, needle)
}

pub fn count(s: string, needle: string) int {
    return __pluto_string_count(s, needle)
}

pub fn is_empty(s: string) bool {
    return __pluto_string_is_empty(s) != 0
}

pub fn is_whitespace(s: string) bool {
    return __pluto_string_is_whitespace(s) != 0
}

pub fn repeat(s: string, count: int) string {
    return __pluto_string_repeat(s, count)
}

// ── Comparison ───────────────────────────────────────────────────────────────

// Lexicographic byte-wise comparison. Returns -1 if a sorts before b, 0 if
// they are equal, and 1 if a sorts after b. A proper prefix sorts first
// ("ab" before "abc"). Bytes compare as unsigned values, so for UTF-8 text
// this is code-point order.
pub fn compare(a: string, b: string) int {
    let la = len(a)
    let lb = len(b)
    let mut n = la
    if lb < n {
        n = lb
    }
    let mut i = 0
    while i < n {
        let ca = byte_at(a, i)
        let cb = byte_at(b, i)
        if ca < cb {
            return -1
        }
        if ca > cb {
            return 1
        }
        i = i + 1
    }
    if la < lb {
        return -1
    }
    if la > lb {
        return 1
    }
    return 0
}

// ── Parsing ──────────────────────────────────────────────────────────────────

// Raised by parse_int / parse_float when the input is not a well-formed
// number. `input` is the offending string; `message` says what was wrong.
pub error ParseError {
    input: string
    message: string
}

// Parse a base-10 integer.
//
// Accepted: an optional leading '-' or '+', followed by one or more ASCII
// digits. Leading zeros are allowed ("007" is 7). The full int range is
// supported, including -9223372036854775808.
//
// Raises ParseError for: the empty string, a sign with no digits, any
// non-digit character (including whitespace anywhere; trim first if you
// want to accept padded input), and values outside the int range. Overflow
// is detected before it happens, so parsing never trips the arithmetic
// overflow trap.
pub fn parse_int(s: string) int {
    let n = len(s)
    if n == 0 {
        raise ParseError { input: s, message: "empty string" }
    }
    let mut i = 0
    let mut negative = false
    let first = byte_at(s, 0)
    if first == 45 {
        negative = true
        i = 1
    } else if first == 43 {
        i = 1
    }
    if i == n {
        raise ParseError { input: s, message: "no digits after sign" }
    }
    // Accumulate as a negative number: the negative range is one larger than
    // the positive range, so this reaches the minimum int without overflow.
    let int_min = -9223372036854775807 - 1
    let min_div_10 = -922337203685477580
    let mut acc = 0
    while i < n {
        let c = byte_at(s, i)
        if c < 48 || c > 57 {
            raise ParseError { input: s, message: f"invalid character at index {i}" }
        }
        let d = c - 48
        if acc < min_div_10 {
            raise ParseError { input: s, message: "out of range for int" }
        }
        acc = acc * 10
        if acc < int_min + d {
            raise ParseError { input: s, message: "out of range for int" }
        }
        acc = acc - d
        i = i + 1
    }
    if negative {
        return acc
    }
    if acc == int_min {
        raise ParseError { input: s, message: "out of range for int" }
    }
    return -acc
}

// Count the ASCII digits in s starting at index `from`.
fn digit_run(s: string, from: int) int {
    let n = len(s)
    let mut i = from
    while i < n {
        let c = byte_at(s, i)
        if c < 48 || c > 57 {
            return i - from
        }
        i = i + 1
    }
    return i - from
}

// Parse a base-10 floating-point number.
//
// Accepted grammar: [+-]? DIGITS ('.' DIGITS)? ([eE] [+-]? DIGITS)?
// where DIGITS is one or more ASCII digits. So "3", "-0.5", "1e9" and
// "2.5E-3" parse; ".5", "5.", "inf", "nan", hex floats and any whitespace
// are rejected with ParseError. A literal too large to represent as a
// finite float (e.g. "1e999") also raises ParseError.
pub fn parse_float(s: string) float {
    let n = len(s)
    if n == 0 {
        raise ParseError { input: s, message: "empty string" }
    }
    let mut i = 0
    let first = byte_at(s, 0)
    if first == 45 {
        i = 1
    } else if first == 43 {
        i = 1
    }
    let int_digits = digit_run(s, i)
    if int_digits == 0 {
        raise ParseError { input: s, message: f"expected digit at index {i}" }
    }
    i = i + int_digits
    if i < n {
        if byte_at(s, i) == 46 {
            i = i + 1
            let frac_digits = digit_run(s, i)
            if frac_digits == 0 {
                raise ParseError { input: s, message: f"expected digit at index {i}" }
            }
            i = i + frac_digits
        }
    }
    if i < n {
        let e = byte_at(s, i)
        if e == 101 || e == 69 {
            i = i + 1
            if i < n {
                let sign = byte_at(s, i)
                if sign == 45 || sign == 43 {
                    i = i + 1
                }
            }
            let exp_digits = digit_run(s, i)
            if exp_digits == 0 {
                raise ParseError { input: s, message: f"expected digit at index {i}" }
            }
            i = i + exp_digits
        }
    }
    if i != n {
        raise ParseError { input: s, message: f"invalid character at index {i}" }
    }
    let v = s.to_float()
    if v == none {
        raise ParseError { input: s, message: "invalid float" }
    }
    // Overflow to infinity: the magnitude exceeds the largest finite double.
    if v > 1.7976931348623157e308 || v < -1.7976931348623157e308 {
        raise ParseError { input: s, message: "out of range for float" }
    }
    return v
}
