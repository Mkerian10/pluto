// Path manipulation utilities

pub fn join(base: string, rel: string) string {
    if base.len() == 0 {
        return rel
    }
    if rel.len() == 0 {
        return base
    }
    let sep = "/"
    if base.ends_with(sep) {
        if rel.starts_with(sep) {
            return base + rel.substring(1, rel.len() - 1)
        }
        return base + rel
    } else {
        if rel.starts_with(sep) {
            return base + rel
        }
        return base + sep + rel
    }
}

pub fn basename(p: string) string {
    if p.len() == 0 {
        return ""
    }
    let sep = "/"
    let last_idx = p.last_index_of(sep)
    if last_idx < 0 {
        return p
    }
    return p.substring(last_idx + 1, p.len() - last_idx - 1)
}

pub fn dirname(p: string) string {
    if p.len() == 0 {
        return "."
    }
    let sep = "/"
    let last_idx = p.last_index_of(sep)
    if last_idx < 0 {
        return "."
    }
    if last_idx == 0 {
        return sep
    }
    return p.substring(0, last_idx)
}

pub fn ext(p: string) string {
    let filename = basename(p)
    let dot_idx = filename.last_index_of(".")
    if dot_idx < 0 {
        return ""
    }
    return filename.substring(dot_idx, filename.len() - dot_idx)
}

pub fn is_absolute(p: string) bool {
    if p.len() == 0 {
        return false
    }
    return p.starts_with("/")
}

pub fn has_trailing_slash(p: string) bool {
    if p.len() == 0 {
        return false
    }
    return p.ends_with("/")
}

pub fn normalize(p: string) string {
    if p.len() == 0 {
        return "."
    }

    // Walk the components with a stack. "." and empty components vanish;
    // ".." pops a real component, clamps at the root of an absolute path,
    // and is KEPT at the front of a relative path ("../../a" must stay
    // "../../a" — dropping it would silently point somewhere else).
    let parts = p.split("/")
    let is_abs = p.starts_with("/")
    let mut stack: [string] = []

    for i in 0..parts.len() {
        let part = parts[i]
        if part.len() == 0 || part == "." {
            continue
        }
        if part == ".." {
            if stack.len() > 0 && stack[stack.len() - 1] != ".." {
                stack.pop()
            } else if !is_abs {
                stack.push("..")
            }
            continue
        }
        stack.push(part)
    }

    let mut result = ""
    for i in 0..stack.len() {
        if i == 0 {
            result = stack[i]
        } else {
            result = result + "/" + stack[i]
        }
    }

    if is_abs {
        return "/" + result
    }
    if result.len() == 0 {
        return "."
    }
    return result
}

pub fn split_ext(p: string) string {
    let filename = basename(p)
    let dot_idx = filename.last_index_of(".")
    if dot_idx < 0 {
        return filename
    }
    return filename.substring(0, dot_idx)
}
