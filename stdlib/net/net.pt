import std.socket

// A listening socket is an entity — it owns an OS resource with identity
// (the bound port). Objects are spawn-shared and serialize their methods,
// so handing a listener to a task never forks the descriptor.
pub object TcpListener {
    fd: int

    // The descriptor is fixed for the entity's life (two-state frame
    // invariant, rfc-properties.md atom 2): the listener never rebinds.
    // (fd >= 0 does NOT hold here — listen() constructs a sentinel
    // listener with fd: -1 on failure instead of raising.)
    invariant self.fd == old(self.fd)

    fn accept(self) TcpConnection {
        let client_fd = socket.accept(self.fd)
        return TcpConnection { fd: client_fd }
    }

    fn port(self) int {
        return socket.get_port(self.fd)
    }

    fn close(self) int {
        return socket.close(self.fd)
    }
}

// One live connection = one entity: reads and writes are messages to the
// same underlying socket, and serialized methods keep concurrent users from
// interleaving mid-operation.
pub object TcpConnection {
    fd: int

    // One connection, one socket, forever: the fd never re-points
    // (two-state frame invariant; the -1 sentinel from connect() failure
    // is a construction value, which two-state clauses do not constrain).
    invariant self.fd == old(self.fd)

    // Reads block at most the deadline set by set_read_timeout (if any);
    // a timed-out read raises TimedOut — a plain local fact ("no bytes
    // arrived within the deadline"), distinct from connection errors and
    // never a claim that the peer failed.
    fn read(self, max_bytes: int) string {
        let data = socket.read(self.fd, max_bytes)
        if socket.read_timed_out() == 1 {
            raise TimedOut { message: "socket read timed out" }
        }
        return data
    }

    // Set a read deadline (milliseconds) for subsequent read() calls on this
    // connection (SO_RCVTIMEO). ms <= 0 clears the deadline.
    fn set_read_timeout(self, ms: int) int {
        return socket.set_read_timeout(self.fd, ms)
    }

    fn write(self, data: string) int {
        return socket.write(self.fd, data)
    }

    // Binary-safe variants: a bytes buffer at the boundary instead of a
    // string. read_bytes returns empty bytes on EOF or error.
    fn read_bytes(self, max_bytes: int) bytes {
        return socket.read_bytes(self.fd, max_bytes)
    }

    fn write_bytes(self, data: bytes) int {
        return socket.write_bytes(self.fd, data)
    }

    fn close(self) int {
        return socket.close(self.fd)
    }
}

pub fn listen(host: string, port: int) TcpListener {
    let fd = socket.create(2, 1, 0)
    if fd < 0 {
        return TcpListener { fd: -1 }
    }
    socket.set_reuseaddr(fd)
    if socket.bind(fd, host, port) < 0 {
        socket.close(fd)
        return TcpListener { fd: -1 }
    }
    if socket.listen(fd, 128) < 0 {
        socket.close(fd)
        return TcpListener { fd: -1 }
    }
    return TcpListener { fd: fd }
}

pub fn connect(host: string, port: int) TcpConnection {
    let fd = socket.create(2, 1, 0)
    if fd < 0 {
        return TcpConnection { fd: -1 }
    }
    if socket.connect(fd, host, port) < 0 {
        socket.close(fd)
        return TcpConnection { fd: -1 }
    }
    return TcpConnection { fd: fd }
}
