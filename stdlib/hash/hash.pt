// std.hash — data-integrity hashes, implemented in pure Pluto.
//
// Provides:
//   - CRC-32C (Castagnoli, polynomial 0x1EDC6F41, reflected 0x82F63B78) —
//     the checksum used by Kafka record batches, iSCSI (RFC 3720), ext4,
//     and most modern storage formats. NOT the zlib/gzip CRC-32.
//   - SHA-256 (FIPS 180-4) — cryptographic digest for content addressing
//     and artifact verification.
//   - FNV-1a 64-bit — a trivial, fast, non-cryptographic hash for cache
//     keys and partitioning. Not collision-resistant; never use it for
//     integrity against an adversary.
//
// Unsigned-32 discipline: Pluto's int is a signed 64-bit integer and `>>`
// is an arithmetic (sign-extending) shift. CRC-32C and SHA-256 are defined
// over unsigned 32-bit words, so every mutating step masks its result with
// `& 0xFFFFFFFF`. That keeps all intermediate values in [0, 2^32), which
// has two consequences: (1) 32-bit wraparound addition is just `+` followed
// by the mask, and (2) since values are always non-negative, the arithmetic
// `>>` behaves exactly like a logical shift — no sign bit ever reaches the
// shifted lanes. The mask after every step is what makes the shift
// semantics a non-issue.
//
// FNV-1a 64 is different: it works in the full 64-bit lane and relies on
// mod-2^64 wraparound, which Pluto's `*` no longer provides (overflow is a
// defect and traps). The state multiply therefore uses the explicit
// wrapping_mul builtin — deliberate modular arithmetic must be visible.
// The returned value is the digest's 64-bit pattern reinterpreted as a
// signed int (it can be negative).
//
// Table initialization: Pluto has no module-level constants or one-time
// static init, so the 256-entry CRC table and the 64-word SHA round-constant
// table are built by factory functions and carried as fields of the
// incremental hasher classes. The one-shot functions construct a hasher per
// call, which regenerates the tables (~2k cheap int ops for CRC); that cost
// is constant and is dwarfed by per-byte work for any non-trivial input. If
// a program hashes many tiny inputs on a hot path, reuse one incremental
// hasher via the factory... or rather construct once and feed it per-record
// (CRC/FNV) — there is deliberately no hidden global cache.
//
// Measured throughput (2026-10, Apple Silicon, 4 MB input, Cranelift
// codegen): crc32c ~126 MB/s, sha256 ~25 MB/s, fnv1a64 ~239 MB/s. These are
// serviceable for framing and artifact checks but 1-2 orders of magnitude
// below hardware-accelerated implementations (ARMv8 CRC32C/SHA-256
// instructions run at multiple GB/s). Standing decision: hardware-intrinsic
// fast paths are DEFERRED until one of these is measured hot in a real
// workload. The dominant soft cost today is per-element runtime calls for
// bytes indexing (see issue #368) — a bulk word-load primitive would lift
// all three without intrinsics.

extern fn __pluto_string_char_at(s: string, index: int) string

// ---------------------------------------------------------------------------
// Hex encoding (digest display)
// ---------------------------------------------------------------------------

// Encode bytes as lowercase hex, two characters per byte.
// hash.to_hex(hash.sha256("abc".to_bytes())) == "ba7816bf..."
pub fn to_hex(data: bytes) string {
    let alpha = "0123456789abcdef"
    let mut out = ""
    let n = data.len()
    let mut i = 0
    while i < n {
        let b = data[i].to_int()
        out = out + __pluto_string_char_at(alpha, (b >> 4) & 0xF)
        out = out + __pluto_string_char_at(alpha, b & 0xF)
        i = i + 1
    }
    return out
}

// ---------------------------------------------------------------------------
// CRC-32C (Castagnoli)
// ---------------------------------------------------------------------------

// Build the 256-entry lookup table for the reflected Castagnoli polynomial.
fn crc32c_table() [int] {
    let mut table: [int] = []
    let mut n = 0
    while n < 256 {
        let mut c = n
        let mut k = 0
        while k < 8 {
            if (c & 1) == 1 {
                c = ((c >> 1) ^ 0x82F63B78) & 0xFFFFFFFF
            } else {
                c = (c >> 1) & 0xFFFFFFFF
            }
            k = k + 1
        }
        table.push(c)
        n = n + 1
    }
    return table
}

// Incremental CRC-32C for streaming use (framing, WAL recovery scans).
//
//   let mut c = hash.new_crc32c()
//   c.update(header)
//   c.update(payload)
//   let crc = c.finish()
//
// finish() is a non-destructive snapshot: it reports the CRC of all bytes
// seen so far, and update() may continue afterwards.
pub class Crc32c {
    table: [int]
    state: int

    // NOTE on contracts (honesty rule): the natural invariants here —
    // `self.state >= 0` and `self.state <= 0xFFFFFFFF` — are true but NOT
    // declared, because the decidable fragment covers linear int arithmetic
    // only: it cannot see through `& 0xFFFFFFFF`, so the obligation does not
    // discharge. Declaring an unprovable invariant is a compile error.

    fn update(mut self, data: bytes) {
        let mut c = self.state
        let n = data.len()
        let mut i = 0
        while i < n {
            let idx = (c ^ (data[i].to_int())) & 0xFF
            c = (self.table[idx] ^ ((c >> 8) & 0xFFFFFF)) & 0xFFFFFFFF
            i = i + 1
        }
        self.state = c
    }

    fn finish(self) int {
        return self.state ^ 0xFFFFFFFF
    }
}

// Create a fresh incremental CRC-32C hasher.
pub fn new_crc32c() Crc32c {
    return Crc32c { table: crc32c_table(), state: 0xFFFFFFFF }
}

// One-shot CRC-32C of a byte buffer. Returns the checksum as an int in
// [0, 2^32). Kafka-compatible: crc32c of 32 zero bytes is 0x8A9136AA
// (RFC 3720 test vector).
pub fn crc32c(data: bytes) int {
    let mut h = new_crc32c()
    h.update(data)
    return h.finish()
}

// ---------------------------------------------------------------------------
// SHA-256 (FIPS 180-4)
// ---------------------------------------------------------------------------

// The 64 round constants (fractional parts of cube roots of the first 64
// primes).
fn sha256_k() [int] {
    return [
        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5,
        0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
        0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc,
        0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7,
        0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
        0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3,
        0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5,
        0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
        0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
    ]
}

// Initial hash state (fractional parts of square roots of the first 8
// primes).
fn sha256_init() [int] {
    return [
        0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
        0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19,
    ]
}

// Rotate a 32-bit value right by n bits. x must already be in [0, 2^32).
fn rotr32(x: int, n: int) int {
    return ((x >> n) | (x << (32 - n))) & 0xFFFFFFFF
}

// One compression round over the 64-byte block at `offset` in `block`.
// Returns the new 8-word state; does not mutate its inputs.
fn sha256_compress(h: [int], k: [int], block: bytes, offset: int) [int] {
    // Message schedule.
    let mut w: [int] = []
    let mut t = 0
    while t < 16 {
        let base = offset + t * 4
        let word = ((block[base].to_int()) << 24)
            | ((block[base + 1].to_int()) << 16)
            | ((block[base + 2].to_int()) << 8)
            | (block[base + 3].to_int())
        w.push(word)
        t = t + 1
    }
    while t < 64 {
        let x15 = w[t - 15]
        let x2 = w[t - 2]
        let s0 = rotr32(x15, 7) ^ rotr32(x15, 18) ^ (x15 >> 3)
        let s1 = rotr32(x2, 17) ^ rotr32(x2, 19) ^ (x2 >> 10)
        w.push((w[t - 16] + s0 + w[t - 7] + s1) & 0xFFFFFFFF)
        t = t + 1
    }

    let mut a = h[0]
    let mut b = h[1]
    let mut c = h[2]
    let mut d = h[3]
    let mut e = h[4]
    let mut f = h[5]
    let mut g = h[6]
    let mut hh = h[7]

    let mut i = 0
    while i < 64 {
        let s1 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25)
        let ch = (e & f) ^ ((e ^ 0xFFFFFFFF) & g)
        let temp1 = (hh + s1 + ch + k[i] + w[i]) & 0xFFFFFFFF
        let s0 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22)
        let maj = (a & b) ^ (a & c) ^ (b & c)
        let temp2 = (s0 + maj) & 0xFFFFFFFF
        hh = g
        g = f
        f = e
        e = (d + temp1) & 0xFFFFFFFF
        d = c
        c = b
        b = a
        a = (temp1 + temp2) & 0xFFFFFFFF
        i = i + 1
    }

    return [
        (h[0] + a) & 0xFFFFFFFF,
        (h[1] + b) & 0xFFFFFFFF,
        (h[2] + c) & 0xFFFFFFFF,
        (h[3] + d) & 0xFFFFFFFF,
        (h[4] + e) & 0xFFFFFFFF,
        (h[5] + f) & 0xFFFFFFFF,
        (h[6] + g) & 0xFFFFFFFF,
        (h[7] + hh) & 0xFFFFFFFF,
    ]
}

// Incremental SHA-256 for streaming use.
//
//   let mut s = hash.new_sha256()
//   s.update(chunk1)
//   s.update(chunk2)
//   let mut digest = s.finish()   // 32-byte bytes value
//
// finish() is a non-destructive snapshot: it pads and finalizes a COPY of
// the running state, so it reports the digest of all bytes seen so far and
// update() may continue afterwards.
pub class Sha256 {
    h: [int]     // running 8-word state
    k: [int]     // round constants (built once per hasher)
    buf: bytes   // pending partial block, always < 64 bytes after update
    total: int   // total bytes absorbed

    // Provable (and proven at every construction and write site): the only
    // write is `self.total = self.total + data.len()`, and `.len()` is a
    // known-non-negative term in the fact fragment. The 32-bit state words
    // in `h` carry no declared invariant — bitwise masking is outside the
    // decidable fragment (see the note on Crc32c).
    invariant self.total >= 0

    fn update(mut self, data: bytes) {
        let n = data.len()
        self.total = self.total + n
        let mut i = 0

        // Top up a pending partial block first.
        if self.buf.len() > 0 {
            let mut buf = self.buf
            while buf.len() < 64 && i < n {
                buf.push(data[i])
                i = i + 1
            }
            if buf.len() == 64 {
                self.h = sha256_compress(self.h, self.k, buf, 0)
                self.buf = bytes_new()
            } else {
                self.buf = buf
                return
            }
        }

        // Full blocks straight from the input.
        while i + 64 <= n {
            self.h = sha256_compress(self.h, self.k, data, i)
            i = i + 64
        }

        // Stash the tail.
        if i < n {
            let mut buf = bytes_new()
            while i < n {
                buf.push(data[i])
                i = i + 1
            }
            self.buf = buf
        }
    }

    fn finish(self) bytes {
        // Pad a local copy: pending bytes + 0x80 + zeros to 56 mod 64 +
        // 64-bit big-endian bit length.
        let mut tail = bytes_new()
        let pending = self.buf.len()
        let mut i = 0
        while i < pending {
            tail.push(self.buf[i])
            i = i + 1
        }
        tail.push((0x80).to_byte())
        while (tail.len() % 64) != 56 {
            tail.push((0).to_byte())
        }
        let bits = self.total * 8
        let mut shift = 56
        while shift >= 0 {
            tail.push(((bits >> shift) & 0xFF).to_byte())
            shift = shift - 8
        }

        let mut h = self.h
        let mut off = 0
        while off < tail.len() {
            h = sha256_compress(h, self.k, tail, off)
            off = off + 64
        }

        // Serialize the state big-endian into the 32-byte digest.
        let mut digest = bytes_new()
        let mut j = 0
        while j < 8 {
            let word = h[j]
            digest.push(((word >> 24) & 0xFF).to_byte())
            digest.push(((word >> 16) & 0xFF).to_byte())
            digest.push(((word >> 8) & 0xFF).to_byte())
            digest.push((word & 0xFF).to_byte())
            j = j + 1
        }
        return digest
    }
}

// Create a fresh incremental SHA-256 hasher.
pub fn new_sha256() Sha256 {
    return Sha256 { h: sha256_init(), k: sha256_k(), buf: bytes_new(), total: 0 }
}

// One-shot SHA-256 of a byte buffer. Returns the 32-byte digest.
// sha256 of empty input is e3b0c442... (FIPS 180-4 / NIST vectors).
pub fn sha256(data: bytes) bytes {
    let mut h = new_sha256()
    h.update(data)
    return h.finish()
}

// Convenience: one-shot SHA-256 returned as a lowercase hex string.
pub fn sha256_hex(data: bytes) string {
    return to_hex(sha256(data))
}

// ---------------------------------------------------------------------------
// FNV-1a 64
// ---------------------------------------------------------------------------

// One-shot FNV-1a 64-bit hash. Fast and simple — for hash tables, cache
// keys, and partition assignment, NOT for integrity checking. Returns the
// 64-bit digest as Pluto's signed int (the bit pattern; may be negative).
//
// The offset basis 0xcbf29ce484222325 does not fit a signed-64 literal, so
// it is assembled from two 32-bit halves; multiplication by the FNV prime
// deliberately wraps mod 2^64, hence wrapping_mul (plain `*` traps on
// overflow).
pub fn fnv1a64(data: bytes) int {
    let mut h = (0xcbf29ce4 << 32) | 0x84222325
    let n = data.len()
    let mut i = 0
    while i < n {
        h = h ^ (data[i].to_int())
        h = wrapping_mul(h, 0x100000001b3)
        i = i + 1
    }
    return h
}
