fn sieve(n: int) int {
    let mut flags = [true]
    let mut i = 1
    while i < n {
        flags.push(true)
        i = i + 1
    }

    let mut count = 0
    let mut p = 2
    while p < n {
        if flags[p] {
            count = count + 1
            let mut m = p + p
            while m < n {
                flags[m] = false
                m = m + p
            }
        }
        p = p + 1
    }
    return count
}

fn main() {
    let n = 500000
    let start = time_ns()
    let result = sieve(n)
    let elapsed = time_ns() - start
    let ms = elapsed / 1000000
    print(f"primes below {n}: {result}")
    print(f"elapsed: {ms} ms")
}
