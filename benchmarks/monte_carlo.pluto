fn main() {
    let n = 100000000
    let start = time_ns()

    // Lehmer LCG PRNG: seed = seed * 16807 % 2147483647
    let mut seed = 42
    let a = 16807
    let m = 2147483647

    let mut inside = 0
    let mut i = 0
    while i < n {
        seed = (seed * a) % m
        let x = (seed.to_float()) / (m.to_float())
        seed = (seed * a) % m
        let y = (seed.to_float()) / (m.to_float())
        if x * x + y * y <= 1.0 {
            inside = inside + 1
        }
        i = i + 1
    }

    let pi_est = 4.0 * (inside.to_float()) / (n.to_float())

    let elapsed = time_ns() - start
    let ms = elapsed / 1000000
    print(f"pi estimate: {pi_est}")
    print(f"elapsed: {ms} ms")
}
