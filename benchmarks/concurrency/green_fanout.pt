// Green fan-out: launch N green tasks all at once, then join them all.
// Many tasks in flight at once exercises the cooperative scheduler's
// fiber-to-fiber handoff (register-only switch) rather than a serial
// main-thread round-trip per task.

fn work(x: int) int {
    let mut s = 0
    let mut k = 0
    while k < 50 {
        s = s + (x + k)
        k = k + 1
    }
    return s
}

fn main() {
    let n = 20000
    let start = time_ns()
    let mut tasks = [green work(0)]
    let mut i = 1
    while i < n {
        tasks.push(green work(i))
        i = i + 1
    }
    let mut acc = 0
    let mut j = 0
    while j < n {
        acc = acc + (tasks[j].get() catch 0)
        j = j + 1
    }
    let ms = (time_ns() - start) / 1000000
    print(f"tasks: {n}")
    print(f"acc: {acc}")
    print(f"elapsed: {ms} ms")
}
