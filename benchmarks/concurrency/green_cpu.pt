// CPU-bound green fan-out: N green tasks each doing independent integer work,
// awaited by main. Measures whether green work uses multiple cores.
//
// Single scheduler (default): all N serialize on one thread (~1 core).
// Multi-scheduler (PLUTO_GREEN_SCHEDULERS=K): top-level spawns round-robin
// across K schedulers and run in parallel, approaching `spawn` throughput at a
// fraction of the per-task cost. On a 10-core box, 8 tasks: ~600 ms at 1
// scheduler vs ~95 ms at 10 (~6x), matching the pthread tier.
//   PLUTO_GREEN_SCHEDULERS=10 ./green_cpu

fn busy(iters: int) int {
    let mut acc = 0
    let mut i = 0
    while i < iters {
        acc = acc + (i * 2654435761) % 1000003
        i = i + 1
    }
    return acc % 7
}
fn main() {
    let n = 8
    let work = 20000000
    let start = time_ns()
    let mut tasks = [green busy(work)]
    let mut i = 1
    while i < n {
        tasks.push(green busy(work))
        i = i + 1
    }
    let mut acc = 0
    let mut j = 0
    while j < n {
        acc = acc + (tasks[j].get() catch 0)
        j = j + 1
    }
    let ms = (time_ns() - start) / 1000000
    print(f"green_cpu tasks={n}")
    print(f"elapsed: {ms} ms")
}
