// Green fiber ceiling: how many tasks can be live at once. N green fibers each
// block on recv from one empty channel (so all park), then close() wakes them
// all. On the pthread tier this is impossible — pthread_create hits EAGAIN at
// ~6k live threads (macOS kern.num_taskthreads=6144). Green fibers park on one
// scheduler thread at ~16 KB resident each (a single page; see the parked-fiber
// precise-scan GC fix), so 50k-100k+ coexist. This is the #369 ceiling win (the
// other half of the case, alongside the ~19x register-switch win).

fn idle(rx: Receiver<int>) int {
    return rx.recv() catch 0
}

fn main() {
    let n = 50000
    let (tx, rx) = chan<int>(1)
    let start = time_ns()
    let mut tasks = [green idle(rx)]
    let mut i = 1
    while i < n {
        tasks.push(green idle(rx))
        i = i + 1
    }
    tx.close()                 // wakes all parked fibers (ChannelClosed)
    let mut done = 0
    let mut j = 0
    while j < n {
        done = done + (tasks[j].get() catch 0)
        j = j + 1
    }
    let ms = (time_ns() - start) / 1000000
    print(f"fibers: {n}")
    print(f"elapsed: {ms} ms")
}
