// Channel throughput: one producer (main) hands N ints to one consumer task
// over an UNBUFFERED channel, forcing a cross-thread rendezvous per message.
// Measures the mutex+condvar send/recv path and the spawn-side handoff cost.
//
// Relevant to Track A (channel deep-copy elision for move-only sends) and to
// Track B (how a green scheduler would turn each recv into a yield).

fn consumer(rx: Receiver<int>, n: int) {
    let mut i = 0
    while i < n {
        let _v = rx.recv() catch -1
        i = i + 1
    }
}

// Inferred-fallible (send can raise on a closed channel); called with `catch`.
fn produce(tx: Sender<int>, n: int) int {
    let mut i = 0
    while i < n {
        tx.send(i)!
        i = i + 1
    }
    return n
}

fn main() {
    let n = 500000
    let (tx, rx) = chan<int>()
    let c = spawn consumer(rx, n)
    let start = time_ns()
    let sent = produce(tx, n) catch -1
    c.get()
    let ms = (time_ns() - start) / 1000000
    print(f"messages: {sent}")
    print(f"elapsed: {ms} ms")
}
