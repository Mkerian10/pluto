// Classic binary-trees (Benchmarks Game shape): a long-lived tree survives
// the whole run while many short-lived trees of increasing depth are built
// and discarded. Generational-friendly: most objects die young.
class Node {
    left: Node?
    right: Node?
}

fn make(d: int) Node {
    if d == 0 {
        return Node { left: none, right: none }
    }
    return Node { left: make(d - 1), right: make(d - 1) }
}

fn check(n: Node) int {
    let mut c = 1
    let l = n.left
    if l != none {
        c = c + check(l)
    }
    let r = n.right
    if r != none {
        c = c + check(r)
    }
    return c
}

fn main() {
    let min_depth = 4
    let max_depth = 16
    let stretch = make(max_depth + 1)
    let mut total = check(stretch)
    let long_lived = make(max_depth)
    let mut depth = min_depth
    while depth <= max_depth {
        let mut iterations = 1
        let mut k = 0
        while k < max_depth - depth + min_depth {
            iterations = iterations * 2
            k = k + 1
        }
        let mut i = 0
        while i < iterations {
            total = total + check(make(depth))
            i = i + 1
        }
        depth = depth + 2
    }
    total = total + check(long_lived)
    print(f"check={total}")
}
