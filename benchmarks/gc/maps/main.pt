// Map-heavy: a large live map with continual insert/overwrite/remove
// churn of object values.
class Val {
    x: int
}

fn main() {
    let mut m = Map<string, Val> {}
    let mut i = 0
    while i < 50000 {
        m.insert(f"k{i}", Val { x: i })
        i = i + 1
    }
    let mut step = 0
    while step < 300000 {
        let k = f"k{(step * 31) % 70000}"
        if step % 3 == 0 {
            m.remove(k)
        } else {
            m.insert(k, Val { x: step })
        }
        step = step + 1
    }
    let mut acc = m.len()
    let mut j = 0
    while j < 70000 {
        let k = f"k{j}"
        if m.contains(k) {
            acc = acc + m[k].x % 1000
        }
        j = j + 1
    }
    print(f"check={acc}")
}
